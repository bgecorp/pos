{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start",
        "-w",
        "@pos/api"
      ],
      "port": 3000,
      "url": "http://localhost:3000"
    },
    {
      "name": "website",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@pos/website"
      ],
      "port": 5173
    },
    {
      "name": "pos",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start",
        "-w",
        "@pos/pos"
      ],
      "port": 4100,
      "env": {
        "POS_DATA_DIR": "C:/Users/Andrew/Desktop/POS/apps/pos/.dev-data"
      }
    }
  ]
}
