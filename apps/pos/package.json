{
  "name": "@pos/pos",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first POS: local Node server + SQLite, used from the browser",
  "scripts": {
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "build": "npm run build:server && npm run build:web",
    "start": "npm run build && node dist-server/server/index.js",
    "dev:server": "npm run build:server && node dist-server/server/index.js",
    "dev:web": "vite",
    "test": "npm run build:server && node dist-server/server/selftest.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "dependencies": {
    "@pos/feature-entitlements": "0.1.0",
    "@pos/shared-types": "0.1.0",
    "better-sqlite3": "^12.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "vite": "^6.4.0"
  }
}
