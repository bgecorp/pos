
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --workspace=@pos/website --include-workspace-root",
  "buildCommand": "npm run build -w @pos/website",
  "outputDirectory": "apps/website/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
