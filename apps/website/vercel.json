
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "website": {
      "root": "apps/website",
      "framework": "vite",
      "installCommand": "cd ../.. && npm ci",
      "buildCommand": "cd ../.. && npm run build:packages && npm run build -w @pos/website",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "api": {
      "root": "apps/api",
      "installCommand": "cd ../.. && npm ci",
      "buildCommand": "cd ../.. && npm run build:packages && npm run build -w @pos/api"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "website"
      }
    }
  ]
}
