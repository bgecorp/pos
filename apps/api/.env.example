# Copy to apps/api/.env and fill in. Never commit the real .env.

# --- PostgreSQL (Supabase) ---------------------------------------------
# Supabase dashboard -> Connect -> "Session pooler" (port 5432, works over IPv4).
# The direct host db.<ref>.supabase.co is IPv6-only and the transaction pooler (6543)
# adds ~1.2s per query with Prisma, so a long-running API uses the session pooler.
# Replace [YOUR-PASSWORD] with your database password (NOT the publishable key).
DATABASE_URL="postgresql://postgres.iiewccggwylgijabzbah:[YOUR-PASSWORD]@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres?connect_timeout=30&connection_limit=10"
DIRECT_URL="postgresql://postgres.iiewccggwylgijabzbah:[YOUR-PASSWORD]@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres?connect_timeout=30"

# --- API ----------------------------------------------------------------
PORT=3000
# Comma-separated origins allowed to call the API (website dev server).
CORS_ORIGINS=http://localhost:5173

# JWT_SECRET: long random string.
JWT_SECRET=change-me-dev-only
# Ed25519 key that signs POS license tokens. Generate with: npm run license:keygen -w @pos/api
# (put the matching public key in apps/pos/server/license-public-key.ts)
LICENSE_PRIVATE_KEY=
LICENSE_TOKEN_DAYS=30

# --- Payments (Phase 4, sandbox only) ----------------------------------
PAYMENT_PROVIDER=paymongo
PAYMONGO_SECRET_KEY=sk_test_xxx
PAYMONGO_WEBHOOK_SECRET=whsk_xxx
